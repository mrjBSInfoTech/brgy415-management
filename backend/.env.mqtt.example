# Add these settings to backend/.env locally and to your backend host's environment.
# Keep your existing database, JWT, and Gemini settings.
# Do not put MQTT credentials in React/frontend environment variables.
IOT_TRANSPORT=mqtt
MQTT_URL=mqtts://YOUR-PRIVATE-BROKER-HOST:8883
MQTT_USERNAME=YOUR-BACKEND-MQTT-USERNAME
MQTT_PASSWORD=YOUR-BACKEND-MQTT-PASSWORD
MQTT_TOPIC_PREFIX=brgy415/alarm-01
